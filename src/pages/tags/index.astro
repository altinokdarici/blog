---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { getPublishedPosts, tagCounts } from "@lib/posts";

const tags = tagCounts(await getPublishedPosts());
---

<PageLayout title="Tags" description="Browse posts by topic.">
  <Container>
    <div class="space-y-10">
      <h1 class="animate text-2xl font-semibold text-black dark:text-white">Tags</h1>
      <ul class="animate flex flex-wrap gap-3">
        {tags.map(([tag, count]) => (
          <li>
            <a
              href={`/tags/${tag}`}
              class="inline-flex items-center gap-2 rounded-lg border border-stone-300 dark:border-stone-700 hover:border-stone-400 dark:hover:border-stone-600 bg-white dark:bg-stone-950 hover:bg-stone-100 dark:hover:bg-stone-900 hover:text-black dark:hover:text-white px-3 py-1.5 text-sm shadow-xs hover:shadow-md transition-all duration-300 ease-in-out"
            >
              <span>#{tag}</span>
              <span class="text-stone-500 dark:text-stone-400">{count}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="animate">
        <Link href="/">Back to all posts</Link>
      </div>
    </div>
  </Container>
</PageLayout>
